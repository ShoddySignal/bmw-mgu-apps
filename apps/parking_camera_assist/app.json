    "de.bmw.dass.parking.parkmenu.userinteraction.UserInteractionParkmenu": {
      "selectedCameraMode": "rs",
      "selectedCamera": "rs",
      "automaticCameraSelected": "rs",
      "operabilitySelectionBar": "rs",
      "_methods": [
        "hmiSelectCameraMode",
        "hmiSelectCamera",
        "hmiSelectAutomaticCamera",
        "assistSelectCameraMode",
        "assistSelectCamera"
      ],
      "_optional": "View selection"
    },
    "de.bmw.dass.parking.parkmenu.parkmenuandlayout.ParkmenuAndLayout": {
      "requestParkmenu": "s",
      "_optional": "Parking layout notifications"
    },
    "de.bmw.dass.parking.ParkmenuInstrumentCluster": {
      "parkmenuRequest": "rs",
      "_methods": [
        "parkmenuRequestedByUser"
      ],
      "_optional": "Instrument cluster parking request"
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_instances": "HMI_CID",
      "currentGraphicalContext": "rs",
      "_optional": "Central display context"
    },
    "de.bmw.infotainment.hmi.hmicontext2.HMIContext2": {
      "currentGraphicalContext": "rs",
      "_optional": "Central display context (HMIContext2)"
    },
    "de.bmw.dass.parking.ParkmenuTextForDisplayCid": {
      "displayPopUp": "rs",
      "_optional": "Parking status messages"
    },
    "de.bmw.dass.XView3D": {
      "CurrentState": "rs",
      "PosAngleFreecamera": "rs",
      "_methods": [
        "changePerspective"
      ],
      "_broadcasts": [
        "PerspectiveChangeTriggered"
      ],
      "_optional": "XView3D perspective"
    },
    "de.bmw.infotainment.video.cameraproxy.ICAM2Proxy": {
      "currentState": "rs",
      "cameraProxyState": "rs",
      "_methods": [
        "clientAttach",
        "changeState",
        "clientDetach"
      ],
      "_optional": "ICAM2 perspective"
    },
    "de.bmw.infotainment.video.cameraplayer.CameraPlayer": {
      "cameraPlayerState": "rs",
      "_methods": [
        "startVideo",
        "stopVideo"
      ],
      "_optional": "Base camera player"
    },
    "de.bmw.infotainment.video.cameraplayer.ParkCameraPlayer": {
      "cameraPlayerState": "rs",
      "watchdogState": "rs",
      "_methods": [
        "startVideo",
        "startProtectedVideo",
        "stopVideo"
      ],
      "_optional": "Parking camera player"
    },
    "de.bmw.infotainment.video.dasvideo.DasVideo": {
      "dasVideoState": "rs",
      "watchdogState": "rs",
      "_methods": [
        "startVideo",
        "stopVideo"
      ],
      "_optional": "DAS video player"
    },
    "de.bmw.infotainment.video.videodisplaystatus.VideoDisplayStatus": {
      "videoDisplayStatus": "rs",
      "_optional": "Video display confirmation"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
