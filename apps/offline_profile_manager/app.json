{
  "id": "offline_profile_manager",
  "title": "Offline Profile Manager",
  "description": "Driver profile management for BMW iDrive 7. Diagnostics tested on BMW X5 G05 with L18_22w18.3-1-6 (mgu-high).",
  "version": "0.1.17",
  "vendor": "Offline Profile Manager",
  "loggingId": "OFPF",
  "mguHmi": [
    "ID7"
  ],
  "license": "MIT",
  "signals": {
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "_instances": "1",
      "statusCarSpeed2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_instances": "1",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s",
      "_optional": "Writes require a gear selector signal"
    }
  },
