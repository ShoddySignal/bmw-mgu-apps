      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": ["sendTasuRequest"],
      "_broadcasts": ["sendTasuResponse"]
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "_optional": "The heater test requires a current vehicle speed"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "statusGearboxDrive": "rs",
      "DataPowerTrain2": "rs",
      "_optional": "The heater test requires a current P selector status"
    }
  },
  "screens": [
