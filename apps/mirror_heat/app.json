        ["text", "HEATING", "Heating status: —"],
        ["text", "DEMAND", "Requested output: —"],
        ["text", "PROTECTION", "Protection (D321): —"],
        ["text", "PARKING", "Parking check: waiting for signals"],
        ["button", "READ", "Read status"],
        ["button", "REVIEW", "Review heater test"],
        ["button", "CONFIRM", "Start 30 s at 100%"],
        ["button", "DETAILS_OPEN", "Diagnostics"]
      ]
    },
    {
      "name": "DETAILS",
      "kind": "menu",
      "title": "Mirror heater diagnostics",
      "items": [
        ["text", "IDENT", "BDC SGBD: —"],
        ["text", "CODED", "Mirror heating coded: —"],
        ["text", "NSC", "NSC activation count: —"],
        ["text", "R_HEAT", "D32D: —"],
        ["text", "R_PROTECT", "D321: —"],
        ["text", "R_COUNT", "2305: —"],
        ["text", "R_EQUIPMENT", "E450: —"],
        ["text", "R_TEST", "Test response: —"],
        ["text3", "NOTE", "Compare both mirror surfaces. BDC data describes a shared command."]
      ]
    }
  ],
  "config": {
    "fullScreenRequired": false,
    "privateLogs": true
  }
